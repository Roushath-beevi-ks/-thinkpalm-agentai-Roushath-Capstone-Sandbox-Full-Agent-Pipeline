# Database (SQLite file created under prisma/)
DATABASE_URL="file:./dev.db"

# Optional: force one provider when multiple keys exist: anthropic | openai | gemini
# LLM_PROVIDER=gemini

# --- Google Gemini (AI Studio key usually starts with AIza...) ---
# Key: https://aistudio.google.com/apikey
# Quotas: https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=
# Try gemini-2.5-flash (default), gemini-2.5-flash-lite, or gemini-1.5-flash if you hit quota on one model
GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=  (alias for GEMINI_API_KEY)

# --- OpenAI (keys usually start with sk-...) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: vector memory embeddings (OpenAI embeddings API only — not Gemini)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: GitHub token for higher rate limits on raw fetches
GITHUB_TOKEN=
